[Unit]
Description=Читает секреты anu-live из MWS Secret Manager в tmpfs /run/anu/secrets
Documentation=file:///opt/anu-live/RUNBOOK.md
# Секреты должны быть на месте до старта контейнеров движка/шлюза.
Before=anu-live.service
After=network-online.target
Wants=network-online.target
# Без секретов запуск движка бессмысленен — но это не должно блокировать
# сам факт загрузки VM (oneshot-неудача не валит systemd в целом).
ConditionPathExists=/run/anu

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/anu-live/anu-secrets.sh
# tmpfs уже 0700 root:root (см. ExecStart); дополнительно запрещаем
# юниту читать что-либо за пределами ожидаемых путей.
ProtectSystem=strict
ReadWritePaths=/run/anu
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
