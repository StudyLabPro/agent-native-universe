[Unit]
# См. примечание в anu-live-mirror.service — тот же путь установки и то же
# условие (только после того, как VM anu-live-1 существует, L5b).
Description=Периодический триггер anu-live-mirror.service

[Timer]
# Стартовое значение, не предписанное архитектурным документом дословно —
# chain/ дёшев для синхронизации (per-epoch JSON-индекс, не сырые события),
# поэтому выбран короткий интервал. Владелец может ослабить его после
# первого реального запуска, если частота окажется избыточной.
OnBootSec=5min
OnUnitActiveSec=15min
Persistent=true

[Install]
WantedBy=timers.target
