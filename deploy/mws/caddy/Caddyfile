# deploy/mws/caddy/Caddyfile — обратный прокси на VM anu-live-1 (фаза L5a,
# docs/GENESIS_LIVE.md §7.2 / L5a "Отклонено", DNS-01 и managed-issuance
# оставлены фолбэками, основной путь — ACME HTTP-01 через caddy на :80).
#
# :80  — ТОЛЬКО ACME HTTP-01. Явно пустой блок: никаких редиректов на
#        https и никакого проксирования какого-либо другого пути. Caddy
#        встраивает обработчик HTTP-01 challenge в любой сервер,
#        слушающий :80, автоматически и раньше пользовательских
#        директив — пустой блок означает, что для всего остального 80-й
#        порт ничего не отдаёт.
# :443 — только для live.anu.studylabpro.com, ЯВНАЯ схема https:// (а не
#        голое имя хоста) — это то, что отключает автоматический редирект
#        с :80, который Caddy иначе добавил бы сам. Доступ ограничен
#        одним источником — Lab — матчером remote_ip.
#
# ВАЖНО ПРО «ДВА НЕЗАВИСИМЫХ СЛОЯ». Сетевой firewall облака сужает трафик
# до того же адреса на уровне VPC — это действительно второй слой. А вот
# host-level firewall на самой VM третьим слоем НЕ является: публикация
# портов контейнера ставит DNAT в nat/PREROUTING, который правила уровня
# хоста обходит. И матчер remote_ip ниже полезен только если Docker
# донёс до Caddy настоящий адрес клиента, а не адрес docker-моста.
# Поэтому профиль `edge` не включается, пока это не подтверждено по
# логам самого Caddy — см. DEPLOY_LIVE.md §9.

:80 {
}

https://live.anu.studylabpro.com {
	@from_lab remote_ip ${ANU_LIVE_LAB_IP}/32

	handle @from_lab {
		# lab-observer-live — имя compose-сервиса из compose.live.yml
		# (фаза L5b, файл ещё не существует на момент написания этого
		# Caddyfile — имя зафиксировано архитектурным документом заранее).
		reverse_proxy lab-observer-live:3000
	}

	handle {
		abort
	}
}
