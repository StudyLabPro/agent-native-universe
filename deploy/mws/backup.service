[Unit]
Description=Ежедневный disk-backup evidence-диска anu-live-evidence-01 + прополка старше 14 копий
Documentation=file:///opt/anu-live/RUNBOOK.md
After=network-online.target anu-secrets.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/anu-live/backup.sh
