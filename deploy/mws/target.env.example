# deploy/mws/target.env.example — ОБРАЗЕЦ локального файла цели развёртывания.
#
# Скопируйте в deploy/mws/target.env (файл в .gitignore) и заполните
# фактическими значениями. Здесь и в самом target.env НЕТ И НЕ ДОЛЖНО БЫТЬ
# НИ ОДНОГО СЕКРЕТА: только адреса, имена и идентификаторы.
#
# ЗАЧЕМ ОН ЕСТЬ. Этот репозиторий публичный, и его AGENTS.md запрещает вносить
# в него «external infrastructure context». Адреса машин, идентификатор
# облачного проекта, имя пользователя SSH и подсети — именно он. Поэтому в
# отслеживаемых файлах стоят имена переменных, а значения живут здесь, на
# машине оператора. Раннбук deploy/mws/DEPLOY_LIVE.md начинается с
# `set -a; . deploy/mws/target.env; set +a` и дальше использует только эти
# переменные.

# Идентификатор проекта в облаке (входит в путь образа в реестре и в URL
# провайдера моделей).
MWS_PROJECT=<project-id>

# Публичный адрес VM живой вселенной (появляется после Ш1 — привязки
# внешнего адреса).
ANU_LIVE_VM_IP=<vm-public-ip>

# Пользователь SSH на этой VM (заводится владельцем на Ш2).
ANU_LIVE_VM_USER=<vm-ssh-user>

# Адрес хоста Lab: единственный источник, которому реестр разрешает PUSH и
# сетевой файрвол — SSH. Нужен для проверок и для матчера remote_ip.
ANU_LIVE_LAB_IP=<lab-ip>

# Домен витрины Observer. Нужен ТОЛЬКО профилю edge (Caddy + TLS); пока
# профиль выключен, значение не используется. Caddy берёт его из окружения
# сервиса lab-edge-live синтаксисом {$ANU_LIVE_DOMAIN}.
ANU_LIVE_DOMAIN=<observer-domain>

# Базовый URL провайдера моделей (OpenAI-совместимый), за которым стоит шлюз.
ANU_LIVE_LLM_UPSTREAM=https://<inference-host>/projects/<project-id>/openai/v1

# Каталог архива улик на Lab (см. DEPLOY_LIVE.md §8): временная станция
# выгрузки, а не хранилище.
ANU_LIVE_LAB_ARCHIVE_DIR=/var/lib/anu-live-archive
