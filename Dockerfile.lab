ARG NODE_IMAGE=node:22-bookworm-slim@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436

FROM ${NODE_IMAGE} AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

COPY tsconfig.json tsconfig.test.json ./
COPY src ./src
RUN npm run build


FROM ${NODE_IMAGE} AS production-dependencies

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts \
    && npm cache clean --force


FROM ${NODE_IMAGE} AS runtime

ARG ANU_VERSION=development
ARG VCS_REF=unknown

ENV NODE_ENV=production
WORKDIR /app

LABEL org.opencontainers.image.title="Agent Native Universe Lab" \
      org.opencontainers.image.description="Hardened read-only Observer and deterministic Universe Lab runner" \
      org.opencontainers.image.source="https://github.com/StudyLabPro/agent-native-universe" \
      org.opencontainers.image.version="${ANU_VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.licenses="MIT"

COPY --chown=node:node package.json package-lock.json ./
COPY --from=production-dependencies --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
COPY --chown=node:node experiments ./experiments

RUN mkdir -p /data \
    && chown node:node /data

USER node

EXPOSE 3000
STOPSIGNAL SIGTERM

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3000/readyz').then((response)=>process.exit(response.ok?0:1)).catch(()=>process.exit(1))"]

CMD ["node", "dist/lab/runner.js", "serve", "--data-dir", "/data", "--port", "3000"]
