# The image can be replaced with a pinned registry reference in deployments.
ANU_LAB_IMAGE=agent-native-universe-lab:local

# This exact hostname is routed by Traefik and receives an HTTP-01 certificate.
ANU_LAB_HOST=lab.anu.xteam.pro

# Fail-closed placeholder. Replace only with rotated ForwardAuth/SSO that does
# not consume the application's Authorization Bearer header. BasicAuth cannot
# be combined with the exact application-level Bearer check.
ANU_LAB_AUTH_MIDDLEWARE=anu-lab-auth-required@docker

# File-backed Docker secret for application-level Bearer authentication on the
# opt-in edge observer. Keep the real token file outside this repository and
# generate at least 32 random token68 characters. /dev/null fails closed.
ANU_LAB_OBSERVER_TOKEN_FILE=/dev/null

# Conservative defaults for the first logical experiment on the current host.
ANU_LAB_UNIVERSES=1
ANU_LAB_AGENTS=16
ANU_LAB_TICKS=500

# Hard shared-host safeguards for both observer and one-shot runner containers.
ANU_LAB_CPUS=2.0
ANU_LAB_MEMORY_LIMIT=2g

# Opt-in cognitive profile. The /dev/null defaults make the profile fail
# closed until real secret files outside the repository are selected.
ANU_LLM_PROVIDER_KEY_FILE=/dev/null
ANU_LLM_GATEWAY_TOKEN_FILE=/dev/null
ANU_LLM_UPSTREAM=https://disabled.invalid/v1
ANU_LLM_MODEL=disabled-model
ANU_LLM_COHORT=B
ANU_LLM_UNIVERSE_ID=U0001

# The cognitive profile is a bounded canary by default. At 50 ticks and four
# consulted agents per tick it plans at most 200 provider requests.
ANU_LLM_TICKS=50

# The gateway is a bounded circuit breaker. Configure the authoritative hard
# financial limit on the provider-scoped key/account as well.
ANU_LLM_GATEWAY_MAX_REQUESTS=250
ANU_LLM_GATEWAY_TOKEN_STOP_THRESHOLD=1000000
ANU_LLM_GATEWAY_RATE_PER_MINUTE=30
ANU_LLM_GATEWAY_MAX_IN_FLIGHT=4
ANU_LLM_GATEWAY_MAX_RESPONSE_BYTES=8388608
ANU_LLM_GATEWAY_MAX_AUDIT_BYTES=67108864
ANU_LLM_GATEWAY_TIMEOUT_MS=180000
ANU_LLM_GATEWAY_CPUS=1.0
ANU_LLM_GATEWAY_MEMORY_LIMIT=512m

# Per-tick cognitive treatment. These values are hashed into the cognition id
# where they affect treatment semantics; concurrency affects pacing only.
ANU_LLM_AGENTS_PER_TICK=4
ANU_LLM_CONCURRENCY=4
ANU_LLM_MAX_TOKENS=2048
