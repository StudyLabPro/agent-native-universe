# .env.live.example — переменные развёртывания Genesis-Live на VM anu-live-1
# (фаза L5b). Копируется на VM как /opt/anu-live/.env (0640, владелец
# root:docker) и читается docker compose рядом с compose.live.yml.
#
# ЗДЕСЬ НЕТ И НЕ БУДЕТ НИ ОДНОГО ЗНАЧЕНИЯ СЕКРЕТА. Три секрета живут
# файлами в tmpfs /run/anu/secrets (их пишет anu-secrets.service из MWS
# Secret Manager); ниже присутствуют только ПУТИ к этим файлам. Секрет,
# попавший в env-файл, попадает в Config.Env контейнера, а оттуда — в
# `docker inspect` и в API демона.
#
# ЗДЕСЬ ТАКЖЕ НЕТ ВНЕШНЕГО ИНФРАСТРУКТУРНОГО КОНТЕКСТА (адресов машин,
# имени облачного проекта): этот репозиторий публичный. Значения в угловых
# скобках оператор подставляет из своего deploy/mws/target.env — файла,
# который в git не входит (образец: deploy/mws/target.env.example).
#
# Машина, под которую подобраны все числа (ФАКТ, проверено 2026-09-08):
# base-4-8 — 4 vCPU, 8 GB RAM, ОДИН boot-диск 50 GB, отдельного диска улик
# нет, внешний адрес не привязан, GPU нет.

# ---------------------------------------------------------------------
# 1. Личность цепочки. Каждая переменная этого блока входит в манифест
#    эпохи (configHash / cognitionId / evaluatorId) и, значит, в runId
#    каждой следующей эпохи. Менять их — осознанное, записываемое
#    действие оператора, а не настройка. Никогда не менять «на ходу»,
#    чтобы «попробовать другую модель».
# ---------------------------------------------------------------------

# Образ движка. ПИННИТЬ ТЕГ ПОИМЁННО (live-<short-sha>, его печатает
# scripts/live/build-push.sh). Плавающий тег означает, что физика и код,
# породившие цепочку, невосстановимы.
#
# ПУТЬ РЕЕСТРА — ПРОВЕРЕННЫЙ ФАКТ (читающий запрос к реестру, 2026-09-08):
# путь БЕЗ имени проекта реестр отвергает
#   GET /v2/anu/agent-native-universe-lab/tags/list
#   -> 400 NAME_INVALID "repository name format should be
#      <project>/<registry>/<repository>",
# тот же запрос с префиксом проекта -> 401 UNAUTHORIZED, то есть имя
# принято. Путь всегда трёхсегментный, и scripts/live/build-push.sh
# строит ровно его.
ANU_LIVE_IMAGE=<registry-host>/<project-id>/anu/agent-native-universe-lab:live-REPLACE-ME

# Физика вселенной. Путь ВНУТРИ образа — именно поэтому её нельзя
# подменить, не сменив тег образа. Обоснование чисел — раздел 7 ниже.
ANU_LIVE_CONFIG=/app/experiments/genesis-live/config.anu-live-1.json

# ИДЕНТИФИКАТОР ВСЕЛЕННОЙ ПЕРЕМЕННОЙ НЕ ЯВЛЯЕТСЯ и в compose зафиксирован
# литералом U0001. Observer знает ровно одну живую вселенную (константа
# LIVE_UNIVERSE_ID в src/lab/live/identity.ts) и отдаёт её в /api/live;
# раннер, пишущий в другую, дал бы пустой Observer молча, без ошибки.

# Ярусы когниции: файл deploy/mws/tiers.anu-live-1.json, скопированный на
# VM. Модели, их maxTokens, цены и requestOverrides входят в cognitionId.
# ИНВАРИАНТ: pricePpm каждого яруса здесь ОБЯЗАН совпадать с
# live.tiers.<ярус>.pricePpm в конфиге вселенной — по первому
# предсказывается платёжеспособность агента, по второму редьюсер списывает
# llmTokens; расхождение делает экономику мышления враньём. Проверяется
# тестом test/lab-live-deployment-anu-live-1.test.mjs.
ANU_LIVE_TIERS_FILE=/opt/anu-live/tiers.json

# Грейдер записанной внешней работы — через тот же шлюз. Его идентичность
# входит в evaluatorId манифеста.
# ПУСТОЕ ЗНАЧЕНИЕ ГРЕЙДЕРА НЕ ОТКЛЮЧАЕТ: форма ${VAR:-default} в compose
# срабатывает и на пустую строку (проверено `docker compose config` —
# при пустом значении в .env вывод содержит модель по умолчанию). Чтобы
# внешняя работа не принималась вовсе, надо удалить строку
# ANU_LIVE_GRADER_MODEL из environment: в compose.live.yml вместе с
# флагом --task-inbox у раннера.
ANU_LIVE_GRADER_MODEL=gpt-oss-120b

# Провайдер за шлюзом. Его хэш входит в gatewayIdentity, а тот — в
# cognitionId. Значения по умолчанию в compose нет намеренно.
# СМЕНА UPSTREAM — НЕ ПРОСТО ПРАВКА ПЕРЕМЕННОЙ: state-файл бюджета шлюза
# привязан к хэшу upstream, и при несовпадении шлюз отказывает
# («Gateway state file belongs to another gateway configuration»), уходя
# с restart: unless-stopped в цикл падений. Процедура — DEPLOY_LIVE.md §7.
ANU_LIVE_LLM_UPSTREAM=https://<inference-host>/projects/<project-id>/openai/v1

# Ровно те модели, что названы в tiers.json и в ANU_LIVE_GRADER_MODEL,
# и ни одной сверх: allowlist шлюза — это граница, а не удобство.
ANU_LIVE_LLM_MODELS=gpt-oss-120b,qwen3-6-35b-a3b,kimi-k2-6

# ---------------------------------------------------------------------
# 2. Пути на хосте. Всё на одном boot-диске 50 GB: отдельного диска улик
#    НЕТ (квота дисков исчерпана). Каталоги создаёт
#    deploy/mws/bootstrap-anu-live-1.sh, владелец — uid 1000.
# ---------------------------------------------------------------------

# Корень улик: <...>/genesis-live/U0001/**, chain/.
ANU_LIVE_EVIDENCE_DIR=/var/lib/anu-live/evidence
# Записанные входы оператора. Монтируются в раннер ТОЛЬКО НА ЧТЕНИЕ.
ANU_LIVE_INBOX_DIR=/var/lib/anu-live/inbox
# Аудит и состояние бюджета шлюза. Это НЕ улики и лежат вне корня улик.
ANU_LIVE_GATEWAY_DIR=/var/lib/anu-live/gateway

# ---------------------------------------------------------------------
# 3. Секреты — ТОЛЬКО пути к файлам в tmpfs. Значений здесь нет.
# ---------------------------------------------------------------------
ANU_LIVE_PROVIDER_KEY_FILE=/run/anu/secrets/anu-live-provider-key
ANU_LIVE_GATEWAY_TOKEN_FILE=/run/anu/secrets/anu-live-gateway-token
ANU_LIVE_OBSERVER_TOKEN_FILE=/run/anu/secrets/anu-live-observer-token

# ---------------------------------------------------------------------
# 4. Стражи супервизора. Развёртывание: ни одно из этих чисел не
#    попадает в улики, и пауза не оставляет в цепочке следа.
# ---------------------------------------------------------------------

# Подряд идущих тиков без единого полученного ответа до паузы.
# ИЗМЕРЕНО (см. §7): этот страж срабатывает не только на сбой провайдера.
# Когда ВСЯ популяция обеднела до «не хватает и на самый дешёвый ярус»,
# консультаций нет вовсе — и супервизор читает это как provider_outage.
# Отличать одно от другого надо по уликам, а не по логу (Ш9).
ANU_LIVE_OUTAGE_TICKS=3

# Порог свободного места на файловой системе улик, байты. 8 GiB.
# У ДВИЖКА ЭТОТ СТРАЖ ПО УМОЛЧАНИЮ ВЫКЛЮЧЕН: runner.ts берёт 0 («default:
# 0, the guard is off»), супервизор — options.minFreeBytes ?? 0, и при 0
# проверка не выполняется вообще; экспортируемая константа
# LIVE_DEFAULT_MIN_FREE_BYTES (20 GiB) не используется нигде. Значит
# потерянная переменная означает НЕ более строгий порог, а отсутствие
# защиты: вселенная забьёт boot-диск вместе с ОС и docker. Поэтому в
# compose стоит форма `:?` (стек не поднимется без значения), а в
# anu-live.service — ExecStartPre, требующий непустое число в .env.
#
# 8 GiB оставляют место на: чекпойнт текущего тика, полный реплей и
# аттестацию текущей эпохи (они пишут summary и attestations уже ПОСЛЕ
# того, как страж мог сработать), журналы docker (3 x 10 MB на сервис) и
# аудит шлюза (до 640 MiB — 5 файлов по 128 MiB, см. §5), плюс запас на
# то, чтобы оператор успел выгрузить улики с хоста.
ANU_LIVE_MIN_FREE_BYTES=8589934592

# Интервал проб восстановления, пока вселенная на паузе.
ANU_LIVE_PROBE_INTERVAL_MS=30000

# Перехват доказательно протухшей аренды писателя (см. комментарий в
# compose.live.yml — там же названа граница этого доказательства между
# контейнерами). true — потому что оператора рядом с машиной нет.
ANU_LIVE_RECOVER_STALE_LEASE=true

# ---------------------------------------------------------------------
# 5. Бюджет шлюза. Скользящее окно, а не пожизненный потолок: у открытой
#    вселенной пожизненный потолок — это дата смерти. Жёсткий финансовый
#    предел ставится на стороне провайдера (ключ SA), не здесь.
#
#    ЧИСЛА СВЕДЕНЫ С ИЗМЕРЕНИЕМ (DEPLOY_LIVE.md §5): одна эпоха
#    fast-яруса — 4000 запросов и 6 320 000 токенов. При измеренной
#    латентности fast ~1 с и 8 одновременных запросов эпоха идёт порядка
#    10–17 минут, то есть темп до ~22 млн токенов и ~14 тыс. запросов в
#    час. Прежние 8 млн/час и 240 запросов/мин были НИЖЕ собственного
#    темпа вселенной: шлюз уходил бы в fail-closed (token_window_exhausted),
#    раннер переставал бы получать ответы, и через --outage-ticks
#    вселенная вставала бы на паузу — автоколебание, вызванное настройкой.
#    Роль окна — предохранитель от разгона (цикл ретраев), а не бюджет.
# ---------------------------------------------------------------------
ANU_LIVE_GATEWAY_BUDGET_WINDOW_MS=3600000
ANU_LIVE_GATEWAY_MAX_TOKENS_PER_WINDOW=36000000
ANU_LIVE_GATEWAY_MAX_REQUESTS_PER_WINDOW=30000
# ИНВАРИАНТ: rate-per-minute ВЫШЕ физического потолка стека. Потолок —
# sum(concurrency ярусов) 4+2+1 плюс грейдер = 8 одновременных запросов;
# при минимальной измеренной латентности ~1 с это до 480 запросов в
# минуту. Значение 240 упиралось ровно в этот потолок, а три подряд 429
# открывают circuit breaker на ANU_LLM_COOLDOWN_MS. Проверяется тестом.
ANU_LIVE_GATEWAY_RATE_PER_MINUTE=900
# ИНВАРИАНТ: не меньше суммы concurrency всех ярусов (4+2+1) плюс грейдер.
ANU_LIVE_GATEWAY_MAX_IN_FLIGHT=8
ANU_LIVE_GATEWAY_MAX_RESPONSE_BYTES=2097152
ANU_LIVE_GATEWAY_TIMEOUT_MS=240000
# Потолок аудита: активный файл ПЛЮС audit-rotate ротированных, то есть
# 5 x 128 MiB = до 640 MiB. Это число входит в обоснование порога диска.
ANU_LIVE_GATEWAY_MAX_AUDIT_BYTES=134217728
ANU_LIVE_GATEWAY_AUDIT_ROTATE=4

# Параметры грейдера (развёртывание, кроме имени модели выше).
ANU_LIVE_GRADER_MAX_TOKENS=512
ANU_LIVE_GRADER_TIMEOUT_MS=120000
ANU_LLM_COOLDOWN_MS=30000
ANU_LLM_CONTENT_BYTE_BUDGET=65536

# ---------------------------------------------------------------------
# 6. Ресурсы контейнеров под 4 vCPU / 8 GB. Сумма лимитов памяти
#    3g + 512m + 1g = 4.5 GB, сумма CPU 2.0 + 0.75 + 1.0 = 3.75 из 4 —
#    остаток осознанно оставлен ОС, dockerd, sshd и агенту облака.
# ---------------------------------------------------------------------
ANU_LIVE_RUNNER_CPUS=2.0
ANU_LIVE_RUNNER_MEMORY_LIMIT=3g
ANU_LIVE_RUNNER_NODE_OPTIONS=--max-old-space-size=2048
ANU_LIVE_RUNNER_STOP_GRACE=600s
ANU_LIVE_GATEWAY_CPUS=0.75
ANU_LIVE_GATEWAY_MEMORY_LIMIT=512m
ANU_LIVE_OBSERVER_CPUS=1.0
ANU_LIVE_OBSERVER_MEMORY_LIMIT=1g

# Observer публикуется только на петле хоста. Наружу — SSH-туннель с Lab.
ANU_LIVE_OBSERVER_PORT=3000

# Профиль `edge` (Caddy на самой VM) выключен: у VM нет привязанного
# внешнего адреса, без него ACME HTTP-01 не проходит. Значения ниже нужны
# только если владелец привяжет адрес и заведёт DNS. Публикация портов
# ставит DNAT в обход правил уровня хоста — см. комментарий в
# compose.live.yml и DEPLOY_LIVE.md §9.
ANU_LIVE_CADDY_IMAGE=caddy:2-alpine
ANU_LIVE_CADDYFILE=/opt/anu-live/Caddyfile
ANU_LIVE_EDGE_BIND=0.0.0.0
ANU_LIVE_EDGE_CPUS=0.25
ANU_LIVE_EDGE_MEMORY_LIMIT=192m

# ---------------------------------------------------------------------
# 7. Почему физика этой вселенной меньше канонической — и что показали
#    измерения. Все числа ниже — ИЗМЕРЕНИЯ на Lab (2026-09-08), а не
#    оценки; каждое воспроизводится прогоном той же физики против
#    настоящего шлюза и заглушки провайдера.
#
#    Канон (experiments/genesis-live/config.json, пиннится тестом и НЕ
#    трогается): 32 агента, ticks/epochTicks 500, checkpointEvery 25,
#    initialResources.llmTokens 200000.
#    Этот хост (experiments/genesis-live/config.anu-live-1.json):
#    16 агентов, ticks/epochTicks 250, checkpointEvery 25,
#    initialResources.llmTokens 400000, собственный seed. Всё остальное —
#    цены действий, поток задач, окна архивации, ярусы, истощение —
#    БАЙТ В БАЙТ каноническое.
#
#    agents 32 -> 16. LiveCognition консультирует КАЖДОГО активного агента
#    КАЖДЫЙ тик, поэтому число агентов — это и есть число обращений к
#    моделям на тик. При суммарной параллельности ярусов 7 шестнадцать
#    агентов дают примерно две волны консультаций на тик, тридцать два —
#    примерно пять; на 4 vCPU и одном шлюзе это разница между вселенной,
#    которая живёт, и вселенной, которая ждёт. Поток задач (tasksPerTick 8)
#    оставлен каноническим намеренно: вдвое меньше агентов на тот же поток
#    работы — вдвое больше работы на агента.
#
#    epochTicks 500 -> 250. Граница эпохи — единственная точка, где
#    вселенная получает реплей, аттестацию, ссылку в chain/ и дешёвую
#    точку возобновления, и единственная точка, где применяется
#    компактизация состояния. Реплей однопоточный и растёт вместе с
#    историей задач внутри эпохи. На 4 vCPU короче эпоха = короче реплей,
#    чаще подтверждённая точка и меньше чекпойнт. 250 > окна архивации
#    (100/100/200), поэтому архивация работает и ВНУТРИ эпохи.
#
#    checkpointEvery 25 — БЕЗ ИЗМЕНЕНИЙ, хотя чекпойнты доминируют по
#    диску. На этой машине дорог не мегабайт, а повторная консультация:
#    падение откатывает вселенную к последнему чекпойнту, то есть теряет
#    до 25 x 16 = 400 реальных обращений к моделям.
#
#    initialResources.llmTokens 200000 -> 400000. ИЗМЕРЕНИЕ, а не расчёт.
#    Прогон fast-яруса (16 агентов, 250 тиков на эпоху, заглушка с usage
#    1580 токенов на консультацию): в эпохе 0 — 4000 записей
#    cognition.recorded, ровно 16 x 250, ни один агент не отсечён по
#    бедности. Списание — 1580 llmTokens за консультацию. При каноническом
#    запасе 200000 первой стеной стал бы токен мышления примерно на тике
#    126. При 400000 стена приходит на тике 253 — ИЗМЕРЕНО: последняя
#    консультация эпохи 1 приходится ровно на тик 253.
#
#    ТРИ ОГОВОРКИ К ЭТОМУ ЧИСЛУ, без которых оно вводит в заблуждение:
#
#    (1) ЯРУС В ИЗМЕРЕНИИ БЫЛ ЗАФИКСИРОВАН ЗАГЛУШКОЙ. Ярус выбирает сама
#        модель (поле nextTier в ответе), а списание — totalTokens x
#        pricePpm яруса: standard втрое, deliberate ввосьмеро дороже
#        fast. В прогоне все 4000 консультаций до одной прошли по
#        ярусу fast, потому что заглушка в каждом ответе возвращала
#        nextTier "fast". Тик 253 — это ВЕРХНЯЯ граница мира, где никто
#        ни разу не попросил думать дороже.
#        ИЗМЕРЕННАЯ НИЖНЯЯ ГРАНИЦА: тот же прогон с заглушкой, всегда
#        просящей deliberate, даёт последнюю консультацию на тике 22
#        (ярусы: deliberate на тиках 2–14, затем автоматическое понижение
#        до standard 15–19 и fast 20–22 по мере обеднения).
#        То есть при нулевом заработке стена по llmTokens лежит между
#        тиком 22 (всё deliberate) и тиком 253 (всё fast) — в 11 раз.
#        Распределение ярусов надо измерять на каждой реальной эпохе
#        (Ш7 раннбука) и только через него пересматривать 400000.
#
#    (2) ПРИ НУЛЕВОМ ЗАРАБОТКЕ ПОПУЛЯЦИЯ ВЫМИРАЕТ. Пополнение llmTokens
#        идёт только через acceptedTaskReward (5 кредитов и 5000 токенов
#        за принятую задачу), плановых вливаний в конфиге нет. Правило
#        live.exhaustion (minThinkTokens 1500, graceTicks 20) отправляет
#        агента, который не может думать, в ОКОНЧАТЕЛЬНУЮ отставку.
#        ИЗМЕРЕНО в прогоне двух эпох подряд: последняя консультация —
#        тик 253, все 16 агентов получают agent.retired{exhausted} на
#        тике 272, и метрика конца эпохи 1 показывает activeAgents 0.
#        В deliberate-прогоне то же самое происходит внутри эпохи 0:
#        отставка всех шестнадцати на тике 40.
#        ЧЕСТНАЯ ГРАНИЦА ЭТОГО ИЗМЕРЕНИЯ: заглушка возвращала фиксированный
#        идентификатор задачи, которого в мире нет, поэтому ни одна задача
#        не была взята и заработка не было ВООБЩЕ (tasksCompleted 0,
#        activeLinks 0, 816 созданных задач и столько же истёкших). Это не
#        доказательство, что вселенная нежизнеспособна, — это измерение
#        худшего случая: выживание целиком зависит от заработка.
#        Практический вывод для раннбука: эпоха 1 обязательна как
#        отдельный шаг с критерием tasksCompleted > 0.
#
#    (3) ОВЕРДРАФТ — СВОЙСТВО ДВИЖКА, А НЕ ДЕФЕКТ РАЗВЁРТЫВАНИЯ.
#        Платёжеспособность предсказывается по maxTokens яруса
#        (fast -> резерв 1024, standard -> 12288, deliberate -> 65536), а
#        списывается по РЕАЛЬНОМУ usage.totalTokens, в который входит и
#        промпт. Списание многоресурсное (ещё кредиты и computeMs),
#        поэтому violation.recorded{cognition overdraft} срабатывает по
#        тому ресурсу, который кончился первым: в измеренном fast-прогоне
#        это были кредиты на тике 144 (1000 начальных при расходе 7 за
#        тик), 1712 нарушений за эпоху. Наблюдать: поле violations в
