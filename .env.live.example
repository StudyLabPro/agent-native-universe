# .env.live.example — переменные развёртывания Genesis-Live на VM anu-live-1
# (фаза L5b). Копируется на VM как /opt/anu-live/.env (0640, владелец
# root:docker) и читается docker compose рядом с compose.live.yml.
#
# ЗДЕСЬ НЕТ И НЕ БУДЕТ НИ ОДНОГО ЗНАЧЕНИЯ СЕКРЕТА. Три секрета живут
# файлами в tmpfs /run/anu/secrets (их пишет anu-secrets.service из MWS
# Secret Manager); ниже присутствуют только ПУТИ к этим файлам. Секрет,
# попавший в env-файл, попадает в Config.Env контейнера, а оттуда — в
# `docker inspect` и в API демона.
#
# Машина, под которую подобраны все числа (ФАКТ, проверено 2026-09-08):
# MWS `anu-live-1`, base-4-8 — 4 vCPU, 8 GB RAM, ОДИН boot-диск 50 GB,
# отдельного диска улик нет, внешний адрес не привязан, GPU нет.

# ---------------------------------------------------------------------
# 1. Личность цепочки. Каждая переменная этого блока входит в манифест
#    эпохи (configHash / cognitionId / evaluatorId) и, значит, в runId
#    каждой следующей эпохи. Менять их — осознанное, записываемое
#    действие оператора, а не настройка. Никогда не менять «на ходу»,
#    чтобы «попробовать другую модель».
# ---------------------------------------------------------------------

# Образ движка. ПИННИТЬ ТЕГ ПОИМЁННО (live-<short-sha>, его печатает
# scripts/live/build-push.sh). Плавающий тег означает, что физика и код,
# породившие цепочку, невосстановимы.
# ПУТЬ РЕЕСТРА НЕ ПОДТВЕРЖДЁН ПЕРВЫМ РЕАЛЬНЫМ PUSH. По косвенному
# свидетельству (SELLERY_INFRA_STATE.md §6) полный путь включает имя
# проекта: registry.mwsapis.ru/project-vxgxs2/<реестр>/<репозиторий>.
# scripts/live/build-push.sh пока собирает путь БЕЗ имени проекта —
# сверить при первом push и привести обе строки к одному виду.
ANU_LIVE_IMAGE=registry.mwsapis.ru/project-vxgxs2/anu/agent-native-universe-lab:live-REPLACE-ME

# Физика вселенной. Путь ВНУТРИ образа — именно поэтому её нельзя
# подменить, не сменив тег образа. Обоснование чисел — раздел 7 ниже.
ANU_LIVE_CONFIG=/app/experiments/genesis-live/config.anu-live-1.json

# Единственная живая вселенная этой цепочки.
ANU_LIVE_UNIVERSE_ID=U0001

# Ярусы когниции: файл deploy/mws/tiers.anu-live-1.json, скопированный на
# VM. Модели и их pricePpm входят в cognitionId. ИНВАРИАНТ: pricePpm
# каждого яруса здесь ОБЯЗАН совпадать с live.tiers.<ярус>.pricePpm в
# конфиге вселенной — по первому предсказывается платёжеспособность
# агента, по второму редьюсер списывает llmTokens; расхождение делает
# экономику мышления враньём.
ANU_LIVE_TIERS_FILE=/opt/anu-live/tiers.json

# Грейдер записанной внешней работы — через тот же шлюз. Его идентичность
# входит в evaluatorId манифеста. Пустое значение = внешняя работа не
# принимается вовсе (тогда уберите и --task-inbox).
ANU_LIVE_GRADER_MODEL=gpt-oss-120b

# Провайдер за шлюзом. Его хэш входит в gatewayIdentity, а тот — в
# cognitionId. Смена upstream = смена технического лечения.
ANU_LIVE_LLM_UPSTREAM=https://gpt.mwsapis.ru/projects/project-vxgxs2/openai/v1

# Ровно те модели, что названы в tiers.json и в ANU_LIVE_GRADER_MODEL,
# и ни одной сверх: allowlist шлюза — это граница, а не удобство.
ANU_LIVE_LLM_MODELS=gpt-oss-120b,qwen3-6-35b-a3b,kimi-k2-6

# ---------------------------------------------------------------------
# 2. Пути на хосте. Всё на одном boot-диске 50 GB: отдельного диска улик
#    НЕТ (квота nbs-pl2 исчерпана). Каталоги создаёт
#    deploy/mws/bootstrap-anu-live-1.sh, владелец — uid 1000.
# ---------------------------------------------------------------------

# Корень улик: <...>/genesis-live/U0001/**, chain/, anchors/.
ANU_LIVE_EVIDENCE_DIR=/var/lib/anu-live/evidence
# Записанные входы оператора. Монтируются в раннер ТОЛЬКО НА ЧТЕНИЕ.
ANU_LIVE_INBOX_DIR=/var/lib/anu-live/inbox
# Аудит и состояние бюджета шлюза. Это НЕ улики и лежат вне корня улик.
ANU_LIVE_GATEWAY_DIR=/var/lib/anu-live/gateway

# ---------------------------------------------------------------------
# 3. Секреты — ТОЛЬКО пути к файлам в tmpfs. Значений здесь нет.
# ---------------------------------------------------------------------
ANU_LIVE_PROVIDER_KEY_FILE=/run/anu/secrets/anu-live-provider-key
ANU_LIVE_GATEWAY_TOKEN_FILE=/run/anu/secrets/anu-live-gateway-token
ANU_LIVE_OBSERVER_TOKEN_FILE=/run/anu/secrets/anu-live-observer-token

# ---------------------------------------------------------------------
# 4. Стражи супервизора. Развёртывание: ни одно из этих чисел не
#    попадает в улики, и пауза не оставляет в цепочке следа.
# ---------------------------------------------------------------------

# Подряд идущих тиков без единого полученного ответа до паузы.
ANU_LIVE_OUTAGE_TICKS=3

# Порог свободного места на файловой системе улик, байты.
# 8 GiB = 8589934592. Встроенный по умолчанию порог движка — 20 GiB — был
# рассчитан на выделенный диск улик 300 GB; на общем boot-диске 50 GB он
# сработал бы почти сразу. 8 GiB оставляют место на: чекпойнт текущего
# тика, полный реплей и аттестацию текущей эпохи (они пишут summary и
# attestations уже ПОСЛЕ того, как страж мог сработать), журналы docker
# (3 x 10 MB на сервис) и аудит шлюза (до ~512 MB), плюс запас на то,
# чтобы оператор успел выгрузить улики с хоста.
ANU_LIVE_MIN_FREE_BYTES=8589934592

# Интервал проб восстановления, пока вселенная на паузе.
ANU_LIVE_PROBE_INTERVAL_MS=30000

# Перехват доказательно протухшей аренды писателя (см. комментарий в
# compose.live.yml). true — потому что оператора рядом с этой машиной нет.
ANU_LIVE_RECOVER_STALE_LEASE=true

# ---------------------------------------------------------------------
# 5. Бюджет шлюза. Скользящее окно, а не пожизненный потолок: у открытой
#    вселенной пожизненный потолок — это дата смерти. Жёсткий финансовый
#    предел ставится на стороне провайдера (ключ SA), не здесь.
# ---------------------------------------------------------------------
ANU_LIVE_GATEWAY_BUDGET_WINDOW_MS=3600000
ANU_LIVE_GATEWAY_MAX_TOKENS_PER_WINDOW=8000000
ANU_LIVE_GATEWAY_MAX_REQUESTS_PER_WINDOW=20000
ANU_LIVE_GATEWAY_RATE_PER_MINUTE=240
# ИНВАРИАНТ: не меньше суммы concurrency всех ярусов (4+2+1) плюс грейдер.
ANU_LIVE_GATEWAY_MAX_IN_FLIGHT=8
ANU_LIVE_GATEWAY_MAX_RESPONSE_BYTES=2097152
ANU_LIVE_GATEWAY_TIMEOUT_MS=240000
ANU_LIVE_GATEWAY_MAX_AUDIT_BYTES=134217728
ANU_LIVE_GATEWAY_AUDIT_ROTATE=4

# Параметры грейдера (развёртывание, кроме имени модели выше).
ANU_LIVE_GRADER_MAX_TOKENS=512
ANU_LIVE_GRADER_TIMEOUT_MS=120000
ANU_LLM_COOLDOWN_MS=30000
ANU_LLM_CONTENT_BYTE_BUDGET=65536

# ---------------------------------------------------------------------
# 6. Ресурсы контейнеров под 4 vCPU / 8 GB. Сумма лимитов памяти
#    3g + 512m + 1g = 4.5 GB, сумма CPU 2.0 + 0.75 + 1.0 = 3.75 из 4 —
#    остаток осознанно оставлен ОС, dockerd, sshd и агенту MWS.
# ---------------------------------------------------------------------
ANU_LIVE_RUNNER_CPUS=2.0
ANU_LIVE_RUNNER_MEMORY_LIMIT=3g
ANU_LIVE_RUNNER_NODE_OPTIONS=--max-old-space-size=2048
ANU_LIVE_RUNNER_STOP_GRACE=600s
ANU_LIVE_GATEWAY_CPUS=0.75
ANU_LIVE_GATEWAY_MEMORY_LIMIT=512m
ANU_LIVE_OBSERVER_CPUS=1.0
ANU_LIVE_OBSERVER_MEMORY_LIMIT=1g

# Observer публикуется только на петле хоста. Наружу — SSH-туннель с Lab.
ANU_LIVE_OBSERVER_PORT=3000

# Профиль `edge` (Caddy на самой VM) выключен: у anu-live-1 нет
# привязанного внешнего адреса, без него ACME HTTP-01 не проходит.
# Значения ниже нужны только если владелец привяжет адрес и заведёт DNS.
ANU_LIVE_CADDY_IMAGE=caddy:2-alpine
ANU_LIVE_CADDYFILE=/opt/anu-live/Caddyfile
ANU_LIVE_EDGE_CPUS=0.25
ANU_LIVE_EDGE_MEMORY_LIMIT=192m

# ---------------------------------------------------------------------
# 7. Почему физика этой вселенной меньше канонической — и почему она всё
#    ещё вселенная, а не игрушка.
#
#    Канон (experiments/genesis-live/config.json, пиннится тестом и НЕ
#    трогается): 32 агента, ticks/epochTicks 500, checkpointEvery 25,
#    initialResources.llmTokens 200000.
#    Этот хост (experiments/genesis-live/config.anu-live-1.json):
#    16 агентов, ticks/epochTicks 250, checkpointEvery 25,
#    initialResources.llmTokens 400000, собственный seed. Всё остальное —
#    цены действий, поток задач, окна архивации, ярусы, истощение —
#    БАЙТ В БАЙТ каноническое.
#
#    agents 32 -> 16. LiveCognition консультирует КАЖДОГО активного агента
#    КАЖДЫЙ тик, поэтому число агентов — это и есть число обращений к
#    моделям на тик. При суммарной параллельности ярусов 7 шестнадцать
#    агентов дают примерно две волны консультаций на тик, тридцать два —
#    примерно пять; на 4 vCPU и одном шлюзе это разница между вселенной,
#    которая живёт, и вселенной, которая ждёт. Второй довод — измерение:
#    единственный завершённый прогон формы «16 агентов x 500 тиков» дал
#    8456 событий и 4 781 044 байта журнала (docs/LAB_CAPACITY.md), так
#    что оценка диска здесь опирается на измеренную точку, а не на
#    экстраполяцию. Поток задач (tasksPerTick 8) оставлен каноническим
#    намеренно: вдвое меньше агентов на тот же поток работы — вдвое
#    больше работы на агента, то есть экономика смещается в сторону
#    платёжеспособности, а не бедности.
#
#    epochTicks 500 -> 250. Граница эпохи — единственная точка, где
#    вселенная получает реплей, аттестацию, ссылку в chain/ и дешёвую
#    точку возобновления, и единственная точка, где применяется
#    компактизация состояния. Реплей — однопоточный и растёт вместе с
#    историей задач внутри эпохи (измерено: реплей 64x10000 занял время,
#    сопоставимое с самим прогоном). На 4 vCPU короче эпоха = короче
#    реплей, чаще подтверждённая точка и меньше чекпойнт. Цена —
#    вдвое больше ссылок в chain/ (десятки байт каждая) и вдвое чаще
#    выметание калибровочных задач на границе. 250 > окна архивации
#    (100/100/200), поэтому архивация работает и ВНУТРИ эпохи, а не
#    только на границе — вселенная остаётся ограниченной по состоянию.
#
#    checkpointEvery 25 — БЕЗ ИЗМЕНЕНИЙ, хотя чекпойнты доминируют по
#    диску. Причина: на этой машине дорог не мегабайт, а повторная
#    консультация. Падение процесса откатывает вселенную к последнему
#    чекпойнту, то есть теряет до 25 тиков x 16 агентов = 400 реальных
#    обращений к моделям. Компактизация держит состояние ограниченным, и
#    чекпойнт 16-агентной архивируемой вселенной мал; удваивать интервал
#    ради мегабайтов, платя сотнями консультаций, — плохой обмен.
#
#    initialResources.llmTokens 200000 -> 400000. Здесь не расчёт, а
#    ИЗМЕРЕНИЕ. Эпоха 0 этой вселенной прогнана целиком (16 агентов,
#    250 тиков, заглушка провайдера с реалистичным usage 1580 токенов на
#    консультацию, Lab, 2026-09-08): 4000 записей cognition.recorded —
#    ровно 16 x 250, то есть КАЖДЫЙ агент консультировался КАЖДЫЙ тик и
#    ни один не был отсечён по бедности; списание — 1580 llmTokens за
#    консультацию. При каноническом запасе 200000 первой стеной стал бы
#    токен мышления (примерно тик 126), то есть физикой вселенной по факту
#    стала бы токенизация конкретного развёртывания. При 400000 стена по
#    llmTokens отодвигается примерно на тик 253, и первым — как и задумано
#    канонической экономикой — начинает связывать заработок: в том же
#    прогоне агенты упёрлись в НОЛЬ КРЕДИТОВ на тике 144 (1000 начальных
#    кредитов при расходе 7 за тик: 2 за консультацию плюс собственные
#    действия), после чего пошли violation.recorded{cognition overdraft}.
#    Это и есть смысл числа 400000: не «подольше пожить», а вернуть
#    экономике канонический порядок узких мест.
#    initialResources.credits НЕ меняется (1000, как в каноне): давление
#    кредитов одинаково на любой машине, оно не следствие 4 vCPU. Оговорка
#    к измерению: заглушка не решала задач вообще, поэтому заработка
#    (acceptedTaskReward: 5 кредитов и 5000 llmTokens за принятую задачу)
#    в прогоне не было — это худший случай, а не ожидаемый.
#
#    seed. У этой вселенной СВОЙ seed (genesis-live-anu-live-1-u0001).
#    Цепочка с другой физикой и так имеет другой configHash и другие
#    runId, но собственный seed делает невозможной даже визуальную
#    путаницу с канонической вселенной в чужом отчёте.
#
#    ЧЕСТНОЕ ЗАМЕЧАНИЕ ОБ ОВЕРДРАФТЕ. Платёжеспособность агента
#    предсказывается по maxTokens яруса (fast -> резерв 1024 единицы,
#    standard -> 6144, deliberate -> 32768), а списывается по РЕАЛЬНОМУ
#    usage.totalTokens, в который входит и промпт: в измеренной эпохе 0
#    резерв был 1024, а фактическое списание — 1580. Плюс списание за
#    консультацию многоресурсное (ещё 2 кредита и 4 computeMs), поэтому
#    violation.recorded{cognition overdraft} на практике срабатывает по
#    тому ресурсу, который кончился первым — в измеренном прогоне это
#    были кредиты на тике 144, а не токены. Это свойство движка
#    (docs/GENESIS_LIVE.md §2.1) и его честная запись в улики, а не дефект
#    развёртывания. maxTokens ярусов подобраны того же порядка, что и
#    реальный расход, чтобы расхождение оставалось краевым эффектом.
#    Наблюдать: поле violations в metrics.recorded и cognitionHealth в
#    /api/live. Рычаг оператора — записанная физика (/var/lib/anu-live/inbox/physics.jsonl):
#    управляющий контур меняет ЦЕНЫ, и только их.
# ---------------------------------------------------------------------
